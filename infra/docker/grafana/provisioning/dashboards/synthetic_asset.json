{
  "uid": "aether-synthetic-asset",
  "title": "Sinteticos | Ativo",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "symbol",
        "label": "Ativo sintetico",
        "datasource": {
          "type": "postgres",
          "uid": "timescale"
        },
        "query": "SELECT name AS __text, symbol AS __value FROM indicator_symbols WHERE active ORDER BY name",
        "refresh": 1,
        "current": {}
      },
      {
        "type": "custom",
        "name": "period",
        "label": "Periodo",
        "query": "M5 : 300,M15 : 900,H1 : 3600",
        "current": {
          "text": "M5",
          "value": "300"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Sinal atual",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescale"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE((SELECT CASE WHEN extract(epoch from now()) >= candle_epoch + 2 * ${period} THEN 0 WHEN side = 'CALL' THEN 1 WHEN side = 'PUT' THEN -1 ELSE 0 END FROM indicator_signals WHERE symbol = '${symbol}' AND period_seconds = ${period} ORDER BY candle_epoch DESC LIMIT 1),0) AS value",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "options": {
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "PUT"
                },
                "0": {
                  "text": "SEM SINAL"
                },
                "1": {
                  "text": "CALL"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Probabilidade CALL",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescale"
          },
          "format": "table",
          "rawSql": "SELECT CASE WHEN extract(epoch from now()) < candle_epoch + 2 * ${period} THEN round((probability * 100)::numeric, 1) ELSE NULL END AS value FROM indicator_signals WHERE symbol = '${symbol}' AND period_seconds = ${period} ORDER BY candle_epoch DESC LIMIT 1",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Idade da ultima vela (s)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescale"
          },
          "format": "table",
          "rawSql": "SELECT extract(epoch from now())::bigint - candle_epoch AS value FROM indicator_signals WHERE symbol = '${symbol}' AND period_seconds = ${period} ORDER BY candle_epoch DESC LIMIT 1",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Acertos observados",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescale"
          },
          "format": "table",
          "rawSql": "SELECT round(100.0 * avg(correct::integer),1) AS value FROM indicator_signals WHERE symbol = '${symbol}' AND period_seconds = ${period} AND correct IS NOT NULL AND $__timeFilter(to_timestamp(candle_epoch))",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Fechamentos reais",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescale"
          },
          "format": "time_series",
          "rawSql": "SELECT to_timestamp(candle_epoch) AS time, close AS value FROM indicator_signals WHERE symbol = '${symbol}' AND period_seconds = ${period} AND $__timeFilter(to_timestamp(candle_epoch)) ORDER BY candle_epoch",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "options": {
        "spanNulls": false
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "showPoints": "always",
            "lineWidth": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Historico auditavel de leituras",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "timescale"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescale"
          },
          "format": "table",
          "rawSql": "SELECT to_timestamp(candle_epoch) AS vela_fechada, side AS sinal, round((probability * 100)::numeric,1) AS prob_call_pct, reason AS estado, model_version AS modelo, observed_side AS direcao_observada, correct AS acertou FROM indicator_signals WHERE symbol = '${symbol}' AND period_seconds = ${period} AND $__timeFilter(to_timestamp(candle_epoch)) ORDER BY candle_epoch DESC LIMIT 500",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 15
      },
      "options": {}
    }
  ]
}
