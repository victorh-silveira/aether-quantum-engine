      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawSql": "SELECT symbol AS ativo, account_mode AS conta, direction AS lado, coalesce(indicator_model_version, model_version, 'standalone') AS versao, count(*) AS contratos_confirmados, count(*) FILTER (WHERE profit > 0) AS vitorias, round((100.0 * count(*) FILTER (WHERE profit > 0) / count(*))::numeric, 1) AS acertos_pct, round(avg(profit / buy_price)::numeric, 4) AS retorno_real_medio, round(coalesce(avg(quote_ev), 0)::numeric, 4) AS ev_cotado_medio FROM contract_executions WHERE profit IS NOT NULL AND buy_price > 0 GROUP BY symbol, account_mode, direction, coalesce(indicator_model_version, model_version, 'standalone') ORDER BY contratos_confirmados DESC, symbol LIMIT 100",
          "format": "table",
          "refId": "A"
