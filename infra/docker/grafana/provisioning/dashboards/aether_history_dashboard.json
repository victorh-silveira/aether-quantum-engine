  "panels": [
    {
      "id": 1,
      "title": "Saldo da sess\u00e3o",
      "description": "Amostras de saldo emitidas durante a sess\u00e3o; n\u00e3o h\u00e1 valor antes da inicializa\u00e7\u00e3o.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "maxDataPoints": 1200,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aether_session_balance_usd and (time() - timestamp(aether_session_balance_usd) < 12)",
          "instant": false,
          "range": true,
          "interval": "$__interval",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          },
          "custom": {
            "drawStyle": "points",
            "lineWidth": 0,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": false,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
