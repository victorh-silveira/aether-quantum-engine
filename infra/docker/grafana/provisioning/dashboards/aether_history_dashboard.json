{
  "annotations": {
    "list": []
  },
  "description": "Amostras históricas do Prometheus. Resolução automática com mínimo de 5 s; pontos sem linhas ou preenchimento.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Visão operacional",
      "type": "dashboards",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "aether-overview-m5"
      ],
      "targetBlank": false
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Saldo da sessão",
      "description": "Amostras de saldo emitidas durante a sessão; não há valor antes da inicialização.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "maxDataPoints": 1200,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aether_session_balance_usd and (time() - timestamp(aether_session_balance_usd) < 12)",
          "instant": false,
          "range": true,
          "interval": "$__interval",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          },
          "custom": {
            "drawStyle": "points",
            "lineWidth": 0,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": false,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
