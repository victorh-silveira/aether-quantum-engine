        "label": "\u00cdndice",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(aether_indicator_close, symbol)",
        "definition": "label_values(aether_indicator_close, symbol)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
